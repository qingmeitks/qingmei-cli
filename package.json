{
  "name": "@qingmeitks/cli",
  "version": "0.0.1",

  "description": "Qingmei Agent CLI with MCP and Skill integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qingmei": "dist/bin/qingmei.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingmeitks/qingmei-cli.git"
  },
  "homepage": "https://github.com/qingmeitks/qingmei-cli#readme",
  "bugs": {
    "url": "https://github.com/qingmeitks/qingmei-cli/issues"
  },

  "scripts": {
    "dev": "tsx bin/qingmei.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "agent",
    "cli",
    "mcp",
    "model-context-protocol",
    "skills",
    "typescript",
    "llm",
    "ai",
    "deepseek",
    "gemini"
  ],
  "author": "Qingmei Team",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "globby": "^14.1.0",
    "marked": "^15.0.7",
    "marked-terminal": "^7.3.0",
    "openai": "^4.86.1",
    "ora": "^8.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}